# Application Config
LOG_LEVEL=INFO

# Play Store Config
PLAY_STORE_APP_ID=com.grofers.customerapp
PLAY_STORE_FETCH_LIMIT=100

# App Store Config
APP_STORE_APP_ID=1393452285
APP_STORE_FETCH_LIMIT=100

# Reddit Config (PRAW credentials)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
